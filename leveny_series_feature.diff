@@ -0,0 +1,171 @@
+/* ============================================================
+   series.css — Leveny
+   Season / Episode selector bar used only on series pages
+   (movies/*.html pages never load this file).
+
+   Desktop: .episode-select-bar sits right above .download-btn.
+   Mobile:  .mob-episode-select-bar sits right above #mobDownloadBtn.
+
+   Both bars hold two side-by-side pills — Season on the left,
+   Episode on the right — each toggling its own dropdown panel.
+   Colors borrow the page's own --mob-accent variable (set per page
+   in css/style<N>.css) so the highlight matches the movie's genre
+   accent automatically.
+============================================================ */
+
+/* -------------------- DESKTOP -------------------- */
+.episode-select-bar {
+  display: flex;
+  gap: 12px;
+  width: 100%;
+  max-width: 700px;
+  margin-top: 25px;
+}
+
+.select-pill {
+  position: relative;
+  flex: 1;
+  background: rgba(20, 20, 20, 0.85);
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 10px;
+  padding: 13px 16px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  cursor: pointer;
+  font-family: "Roboto Slab", Rockwell, sans-serif;
+  color: #fff;
+  font-size: 15px;
+  font-weight: 600;
+  user-select: none;
+  transition: background 0.2s ease;
+}
+
+.select-pill:hover {
+  background: rgba(38, 38, 38, 0.9);
+}
+
+.select-pill-chevron {
+  font-size: 12px;
+  opacity: 0.7;
+  transition: transform 0.2s ease;
+}
+
+.select-pill.open .select-pill-chevron {
+  transform: rotate(180deg);
+}
+
+.select-panel {
+  position: absolute;
+  top: calc(100% + 8px);
+  left: 0;
+  right: 0;
+  max-height: 260px;
+  overflow-y: auto;
+  background: rgba(14, 14, 14, 0.97);
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  border-radius: 10px;
+  display: none;
+  z-index: 60;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
+}
+
+.select-pill.open .select-panel {
+  display: block;
+}
+
+.select-panel-item {
+  padding: 11px 16px;
+  font-size: 14px;
+  font-family: "Roboto Slab", Rockwell, sans-serif;
+  color: #eee;
+  cursor: pointer;
+  transition: background 0.15s ease;
+}
+
+.select-panel-item:hover {
+  background: rgba(255, 255, 255, 0.08);
+}
+
+.select-panel-item.active {
+  color: var(--mob-accent, #00a8ff);
+  font-weight: 700;
+}
+
+/* -------------------- MOBILE -------------------- */
+.mob-episode-select-bar {
+  display: flex;
+  gap: 10px;
+}
+
+.mob-select-pill {
+  position: relative;
+  flex: 1;
+  background: rgba(255, 255, 255, 0.10);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border: 1px solid var(--mob-accent-dim, rgba(255, 255, 255, 0.15));
+  border-radius: 14px;
+  padding: 12px 14px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  cursor: pointer;
+  font-family: "Roboto Slab", Rockwell, sans-serif;
+  color: var(--mob-accent, #00a8ff);
+  font-size: 14px;
+  font-weight: 700;
+  user-select: none;
+}
+
+body.dark-mode .mob-select-pill {
+  background: var(--mob-accent-dim, rgba(255, 255, 255, 0.08));
+}
+
+.mob-select-pill-chevron {
+  font-size: 11px;
+  opacity: 0.75;
+  transition: transform 0.2s ease;
+}
+
+.mob-select-pill.open .mob-select-pill-chevron {
+  transform: rotate(180deg);
+}
+
+.mob-select-panel {
+  position: absolute;
+  top: calc(100% + 8px);
+  left: 0;
+  right: 0;
+  max-height: 220px;
+  overflow-y: auto;
+  background: rgba(20, 20, 20, 0.97);
+  border-radius: 14px;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  display: none;
+  z-index: 60;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
+}
+
+.mob-select-pill.open .mob-select-panel {
+  display: block;
+}
+
+.mob-select-panel-item {
+  padding: 11px 16px;
+  font-size: 13px;
+  font-family: "Roboto Slab", Rockwell, sans-serif;
+  color: #eee;
+  cursor: pointer;
+}
+
+.mob-select-panel-item:active {
+  background: rgba(255, 255, 255, 0.08);
+}
+
+.mob-select-panel-item.active {
+  color: var(--mob-accent, #00a8ff);
+  font-weight: 700;
+}
