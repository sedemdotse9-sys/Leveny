+  // ------------------------------------------------------------------
+  // Movie <-> Series mode toggle
+  // ------------------------------------------------------------------
+  const modeMovieBtn  = document.getElementById('modeMovieBtn');
+  const modeSeriesBtn = document.getElementById('modeSeriesBtn');
+  const movieFields   = document.getElementById('movieFields');
+  const seriesNewFields = document.getElementById('seriesNewFields');
+  const seriesEpisodeFields = document.getElementById('seriesEpisodeFields');
+  const existingNotice = document.getElementById('existingSeriesNotice');
+  const titleHint = document.getElementById('titleHint');
+  const mainForm = document.getElementById('mainForm');
+  const submitBtn = document.getElementById('submitBtn');
+  const pageTitle = document.getElementById('pageTitle');
+  const pageSub = document.getElementById('pageSub');
+  const titleLabel = document.getElementById('titleLabel');
+  const bottomNav = document.getElementById('bottomNav');
+  const seasonLabel = document.getElementById('seasonLabel');
+
+  const MOVIE_URL = "{{ url_for('generate') }}";
+  const SERIES_URL = "{{ url_for('generate_series') }}";
+  const CHECK_SERIES_URL = "{{ url_for('check_series') }}";
+
+  let mode = 'movie';       // 'movie' | 'series'
+  let seriesExists = false; // does the currently-typed series title already exist?
+
+  function setFieldsEnabled(container, enabled) {
+    container.querySelectorAll('input, select, textarea').forEach(el => {
+      el.disabled = !enabled;
+    });
+  }
+
+  function applyMode() {
+    if (mode === 'movie') {
+      pageTitle.textContent = 'Add a Movie';
+      pageSub.textContent = 'Generates the HTML page, page CSS, and a movies.js entry.';
+      titleLabel.textContent = 'Movie Title';
+      titleHint.style.display = 'none';
+      existingNotice.style.display = 'none';
+      movieFields.style.display = '';
+      seriesNewFields.style.display = 'none';
+      seriesEpisodeFields.style.display = 'none';
+      submitBtn.textContent = 'Generate Movie Page';
+      mainForm.action = MOVIE_URL;
+      bottomNav.textContent = 'movies/ \u00b7 css/ \u00b7 js/movies.js';
+      setFieldsEnabled(movieFields, true);
+      setFieldsEnabled(seriesNewFields, false);
+      setFieldsEnabled(seriesEpisodeFields, false);
+    } else {
+      pageTitle.textContent = 'Add a Series';
+      pageSub.textContent = 'Generates a series page, or adds episodes to one you already have.';
+      titleLabel.textContent = 'Series Title';
+      titleHint.style.display = '';
+      movieFields.style.display = 'none';
+      mainForm.action = SERIES_URL;
+      bottomNav.textContent = 'series/ \u00b7 css/ \u00b7 js/movies.js';
+      setFieldsEnabled(movieFields, false);
+      seriesEpisodeFields.style.display = '';
+      setFieldsEnabled(seriesEpisodeFields, true);
+      applySeriesExistence();
+    }
+  }
+
+  function applySeriesExistence() {
+    if (seriesExists) {
+      seriesNewFields.style.display = 'none';
+      setFieldsEnabled(seriesNewFields, false);
+      existingNotice.style.display = '';
+      submitBtn.textContent = 'Add Episode(s)';
+      seasonLabel.textContent = 'Season number (existing or new)';
+    } else {
+      seriesNewFields.style.display = '';
+      setFieldsEnabled(seriesNewFields, true);
+      existingNotice.style.display = 'none';
+      submitBtn.textContent = 'Create Series';
+      seasonLabel.textContent = 'Season number';
+    }
+  }
+
+  modeMovieBtn.addEventListener('click', () => {
+    mode = 'movie';
+    modeMovieBtn.classList.add('active');
+    modeSeriesBtn.classList.remove('active');
+    applyMode();
+  });
+
+  modeSeriesBtn.addEventListener('click', () => {
+    mode = 'series';
+    modeSeriesBtn.classList.add('active');
+    modeMovieBtn.classList.remove('active');
+    applyMode();
+  });
+
+  // ------------------------------------------------------------------
+  // Looking up whether a typed series title already exists
+  // ------------------------------------------------------------------
+  let checkTimer = null;
+
+  function scheduleSeriesCheck() {
+    if (mode !== 'series') return;
+    clearTimeout(checkTimer);
+    const title = titleInput.value.trim();
+    if (!title) {
+      seriesExists = false;
+      applySeriesExistence();
+      resetEpisodeRows(1);
+      return;
+    }
+    checkTimer = setTimeout(() => {
+      fetch(CHECK_SERIES_URL + '?title=' + encodeURIComponent(title))
+        .then(r => r.json())
+        .then(data => {
+          if (mode !== 'series') return; // user switched away meanwhile
+          seriesExists = !!data.exists && !data.unrecognized;
+          applySeriesExistence();
+
+          if (seriesExists) {
+            const seasonKeys = Object.keys(data.seasons || {}).map(Number).sort((a, b) => a - b);
+            const highestSeason = seasonKeys.length ? seasonKeys[seasonKeys.length - 1] : 1;
+            const highestSeasonEpisodes = (data.seasons[String(highestSeason)] || [])
+              .map(e => e.episode);
+            const nextEpisode = highestSeasonEpisodes.length ? Math.max(...highestSeasonEpisodes) + 1 : 1;
+
+            existingNotice.innerHTML =
+              '<strong>"' + title + '"</strong> already exists (' + seasonKeys.length +
+              ' season' + (seasonKeys.length === 1 ? '' : 's') + ' so far). ' +
+              'Whatever you add below will be merged into it \u2014 the show\u2019s existing ' +
+              'genre, summary, poster, etc. are kept as they are.';
+
+            document.getElementById('seasonInput').value = highestSeason;
+            resetEpisodeRows(nextEpisode);
+          } else {
+            resetEpisodeRows(1);
+          }
+        })
+        .catch(() => { /* offline or route unavailable — just leave "new series" mode */ });
+    }, 400);
+  }
+
+  titleInput.addEventListener('input', () => {
+    if (mode === 'movie') autofillMovieFilenames();
+    else scheduleSeriesCheck();
+  });
+
+  // ------------------------------------------------------------------
+  // Dynamic episode rows
+  // ------------------------------------------------------------------
+  const episodeRowsEl = document.getElementById('episodeRows');
+  const addEpisodeBtn = document.getElementById('addEpisodeBtn');
+  const episodesJsonInput = document.getElementById('episodesJsonInput');
+
+  function addEpisodeRow(episodeNumber, downloadValue) {
+    const row = document.createElement('div');
+    row.className = 'episode-row';
+    row.innerHTML =
+      '<input type="number" class="ep-num" min="1" value="' + episodeNumber + '" placeholder="Ep #">' +
+      '<input type="text" class="ep-download" placeholder="https://wildshare.net/..." value="' + (downloadValue || '') + '">' +
+      '<button type="button" class="episode-row-remove" aria-label="Remove episode">\u00d7</button>';
+    row.querySelector('.episode-row-remove').addEventListener('click', () => {
+      if (episodeRowsEl.children.length > 1) row.remove();
+    });
+    episodeRowsEl.appendChild(row);
+  }
+
+  function resetEpisodeRows(startingEpisode) {
+    episodeRowsEl.innerHTML = '';
+    addEpisodeRow(startingEpisode || 1, '');
+  }
+
+  addEpisodeBtn.addEventListener('click', () => {
+    const nums = Array.from(episodeRowsEl.querySelectorAll('.ep-num')).map(i => parseInt(i.value, 10) || 0);
+    const next = nums.length ? Math.max(...nums) + 1 : 1;
+    addEpisodeRow(next, '');
   });
+
+  resetEpisodeRows(1);
+
+  mainForm.addEventListener('submit', (e) => {
+    if (mode !== 'series') return; // movie mode needs no extra work
+    const episodes = Array.from(episodeRowsEl.children).map(row => ({
+      episode: parseInt(row.querySelector('.ep-num').value, 10),
+      download: row.querySelector('.ep-download').value.trim(),
+    })).filter(ep => ep.download && !isNaN(ep.episode));
+
+    if (!episodes.length) {
+      e.preventDefault();
+      alert('Add at least one episode with a download link.');
+      return;
+    }
+    episodesJsonInput.value = JSON.stringify(episodes);
+  });
+
+  applyMode();
 </script>
